[Unit]
Description=Wake a local Claude Code session for board work only this machine can do
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/ChatGPT/RLWRLD workspace
ExecStart=/bin/bash %h/Documents/ChatGPT/RLWRLD workspace/scripts/wake-local.sh
# The wake script bounds the session itself with timeout(1) and writes its
# state file afterwards. Leave room above that so systemd never kills it
# between the session ending and the state being recorded.
TimeoutStartSec=4200
