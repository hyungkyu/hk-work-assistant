[Unit]
Description=Daily five-source collection, capture through ledger to database
# The batch this replaces lived in the system unit directory, where the cloud
# side cannot read or repair it -- so when it turned out to be running two of
# five sources, nobody on this side could fix it. A batch nobody can inspect is
# a batch that drifts.
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/ChatGPT/RLWRLD workspace
# `DATABASE_URL` and nothing else lives here. A systemd user service inherits
# nothing from a login shell, so without this the load stage finds no database,
# skips, and the run still finishes -- captured everything, stored none of it,
# with the manifests and the coverage grid reading clean either way. That is
# how it stood on 2026-09-06.
#
# A file rather than `systemctl --user import-environment`, which is held in
# the running manager and is gone after a reboot; and a leading `-` so the unit
# still starts when the file is absent, because a collection that captures
# without loading is worth more than one that does not run. The file is not in
# this repository and must not be: it holds a password.
EnvironmentFile=-%h/.config/hk-work-assistant/collect.env
# No --source flags: the default is all five. Naming them here is what let the
# installed batch fall three sources behind the code without anyone noticing.
ExecStart=/bin/bash "%h/Documents/ChatGPT/RLWRLD workspace/scripts/run-logged.sh" daily-collect -- "%h/Documents/ChatGPT/RLWRLD workspace/.venv/bin/worklog" daily-collect
# A full five-source run walks every Slack channel and every Notion page it has
# not seen. Six hours is well above the longest observed run and still bounded.
TimeoutStartSec=21600
