[Unit]
Description=Build and restart the services when the tree has moved, and prove the image is the commit
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/ChatGPT/RLWRLD workspace
ExecStart=/bin/bash "%h/Documents/ChatGPT/RLWRLD workspace/scripts/deploy-tick.sh"
# A cold build of this image takes minutes. Bound it well above that rather
# than leaving it unbounded, and above the tick's own container-wait loop.
TimeoutStartSec=2700
