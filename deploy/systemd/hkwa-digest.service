[Unit]
Description=Read the roster, build yesterday's per-person digests, render the org chart
# The org chart and every person's day are generated by this unit and by
# nothing else. Nobody edits them, and no model writes them.
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/ChatGPT/RLWRLD workspace
# Through run-logged.sh, so a run that starts and dies leaves a record rather
# than nothing, and the backoffice's batch screen can see it like any other.
ExecStart=/bin/bash "%h/Documents/ChatGPT/RLWRLD workspace/scripts/run-logged.sh" digest -- /bin/bash "%h/Documents/ChatGPT/RLWRLD workspace/scripts/digest-tick.sh"
TimeoutStartSec=3600
