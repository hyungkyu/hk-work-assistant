[Unit]
Description=Daily collection audit at 02:00 KST before the long collection window

[Timer]
# The collection batch now starts at 06:00 and may take more than two hours.
# Audit at 02:00 reads completed data through yesterday without overlapping it.
OnCalendar=*-*-* 02:00:00 Asia/Seoul
# A machine asleep at 02:00 audits when it wakes rather than skipping the day.
# A skipped audit is a day nobody checked, which is the state this unit exists
# to end.
Persistent=true
RandomizedDelaySec=120
AccuracySec=60s
Unit=hkwa-collection-audit.service

[Install]
WantedBy=timers.target
