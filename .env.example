# Copy to .env and fill in. See docs/environment.md for every variable this
# repository reads, where it is read, and its default.
#
# Only the names listed in a service's `environment:` block in compose.yaml
# reach that container. A value set here but absent from that block affects
# nothing inside the container.

POSTGRES_DB=worklog
POSTGRES_USER=worklog
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://worklog:replace-with-a-long-random-password@postgres:5432/worklog

# Passed to app, backoffice-local and backoffice-lan, and read by no code in
# this repository. The OpenSearch container starts; nothing queries it yet.
OPENSEARCH_URL=http://opensearch:9200

APP_PORT=8080
HOST_UID=1000
HOST_GID=1000
RAW_ARCHIVE_HOST_ROOT=/data/rlwrld-worklog
RAW_ARCHIVE_ROOT=/data/rlwrld-worklog
# Standard v1 ledger JSONL staging. Defaults to $RAW_ARCHIVE_ROOT/staging/ledger.
LEDGER_ROOT=/data/rlwrld-worklog/staging/ledger
# Legacy (V0) daily_raw dumps, read only for 수집 현황 coverage.
# Defaults to $RAW_ARCHIVE_ROOT/legacy/claude/weekly.
# LEGACY_ROOT=/data/rlwrld-worklog/legacy/claude/weekly

# Extra archive roots for backfill coverage, separated by ":". Unset means the
# roots are auto-discovered; an explicit empty value means the live root only.
# BACKFILL_ARCHIVE_ROOTS=

# Where collection progress snapshots are written. Falls back to
# APP_CONFIG_ROOT. With neither set, a collector writes no snapshot at all.
# COLLECTION_PROGRESS_ROOT=

# Required by compose, read by no code in this repository. The account allowlist
# actually lives in APP_CONFIG_ROOT/settings.json under "allowed_google_email"
# and is set from the backoffice. Changing this value changes no permission.
ALLOWED_GOOGLE_EMAIL=owner@example.com

# Must already exist, owned by HOST_UID:HOST_GID, before `docker compose up`.
# Create it with scripts/prepare-admin-config.sh.
APP_CONFIG_HOST_ROOT=/home/owner/.config/hk-work-assistant
APP_CONFIG_ROOT=/config/hk-work-assistant

# Sets the `secure` attribute on the admin session cookie. Use true behind HTTPS.
ADMIN_SESSION_SECURE=false

# The emergency password login. compose.yaml sets this per service as a literal
# ("true" for backoffice-local only) and ignores any value set here.
# EMERGENCY_LOGIN_ENABLED=false

# Host address for backoffice-local's port 8081. Must differ from
# LAN_BIND_ADDRESS: backoffice-lan publishes 8081 too, and identical addresses
# collide.
BACKOFFICE_BIND_ADDRESS=127.0.0.1

# Placeholders. compose publishes ports on these addresses literally, so a host
# that does not hold the address cannot bind it. Replace with this machine's
# Tailscale IPv4 and LAN IPv4.
VPN_BIND_ADDRESS=100.64.0.1
LAN_BIND_ADDRESS=192.168.1.10

# --- Collector settings, none of them required to bring the stack up ---------
# Tokens do not belong in this file. Put them in secrets/slack.env or under
# APP_CONFIG_ROOT/credentials/, which is where the collectors look first.

# Notion integration token. Prefer APP_CONFIG_ROOT/credentials/.
# NOTION_TOKEN=

# Google OAuth token file, used when APP_CONFIG_ROOT/credentials/ has none.
# Relative paths resolve against the current working directory.
# GOOGLE_TOKEN_PATH=secrets/google-token.json

# GitHub org to collect. Defaults to rlwrld.
# GITHUB_ORG=

# Bare mirror directory for github-collect. Defaults to
# /data/rlwrld-worklog/legacy/claude/weekly/scripts/github_mirrors
# GITHUB_MIRROR_ROOT=

# Token handed to the gh CLI when no stored credential is found.
# GITHUB_TOKEN=

# Executable names for the GitHub client. Read once at import time, so a change
# after the process starts has no effect. Default: gh and git.
# GH_BIN=gh
# GIT_BIN=git

# Slurm accounting dump service. Read once at import time; slurm-collect
# --base-url overrides it per run. Default: http://infra-node:8888
# SLURM_DUMP_BASE_URL=

# Actor recorded in the delegated-work history for CLI writes. Default local-cli.
# WORKLOG_ACTOR=

# --- Test and local automation, not used by compose --------------------------

# A throwaway database that enables the two real round-trip tests in
# tests/test_ledger_load.py. This creates schemas and writes rows: never point
# it at the operational database.
# WORKLOG_TEST_DATABASE_URL=

# scripts/wake-local.sh: which assigned_to value this machine picks up, and the
# timeout(1) bound on a woken session. Defaults: local and 3600 seconds.
# WAKE_EXECUTOR=
# WAKE_TIMEOUT=

# Slack credentials live in secrets/slack.env, never in this file.
